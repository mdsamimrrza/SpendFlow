# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env*.local
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# ── Expo ──────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
.expo-web-export-check/

# ── Build Artifacts ───────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa

# ── Native (generated — do not commit, regenerate with npx expo prebuild) ─────
/ios
/android

# ── Metro bundler ─────────────────────────────────────────────────────────────
.metro-health-check*

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Debug & Logs ──────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.expo/dev/logs/

# ── Firebase (keep google-services.json out of source control) ────────────────
google-services.json
android/app/google-services.json
ios/GoogleService-Info.plist

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Temp ──────────────────────────────────────────────────────────────────────
.temp/
*.temp
.kotlin/
*.orig.*
