{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.1",
      "corepack": true
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.23.1",
      "corepack": true
    },

    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "22.23.1",
      "corepack": true
    },

    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "node": "22.23.1",
      "corepack": true
    }
  },

  "submit": {
    "production": {}
  }
}