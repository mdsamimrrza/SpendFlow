# Dependencies
node_modules/

# Environment and credentials
# NOTE (audit run-1): when .easignore exists, EAS uses it INSTEAD of .gitignore
# for the uploaded build archive — this list must mirror .gitignore's secret
# block exactly. .env.maintenance (service-role key + SMTP creds) was missing.
.env
.env.maintenance
.env.local
.env*.local
firebase-service-account.json
service-account.json
service-account-*.json
serviceAccountKey.json
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Expo and build artifacts
.expo/
dist/
web-build/
expo-env.d.ts
.expo-web-export-check/
*.apk
*.aab
*.ipa

# Native directories generated by EAS
/ios
/android

# Bundler, TypeScript, logs, and temporary files
.metro-health-check*
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.expo/dev/logs/
.temp/
*.temp
.kotlin/
*.orig.*

# IDE and OS files
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
Thumbs.db

# Firebase files not needed by EAS
ios/GoogleService-Info.plist

# Generated in CI from the GOOGLE_SERVICES_JSON secret
!google-services.json