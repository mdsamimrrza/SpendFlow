{
  "expo": {
    "name": "SpendFlow",
    "slug": "spendflow",
    "owner": "samimreza",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spendflow",
    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.samimrrza.spendflow",
      "supportsTablet": false
    },

    "android": {
      "package": "com.samimrrza.spendflow",
      "versionCode": 3,

      "googleServicesFile": "./google-services.json",

      "softwareKeyboardLayoutMode": "resize",

      "adaptiveIcon": {
        "backgroundColor": "#F2EFE9",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow SpendFlow to photograph receipts so amounts and details can be filled in automatically.",
          "photoLibraryPermission": "Allow SpendFlow to attach receipt photos from your library."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2EFE9",
          "dark": {
            "image": "./assets/splash-icon-blank.png",
            "backgroundColor": "#0B0F19"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#A8791F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SpendFlow to use Face ID to securely unlock your expense tracker."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-android-build-config",
      "./plugins/with-android-backup-rules"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "db912006-55b7-4be4-9a0a-42f8935bbf17"
      }
    },

    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}