# ── App .env — PUBLIC values only ────────────────────────────────────────────
# Expo may inline EXPO_PUBLIC_* variables into the client bundle: NEVER put a
# secret here. This file is gitignored; keep it in sync with the team.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_EXCHANGE_RATE_API_URL=
EXPO_PUBLIC_EXCHANGE_RATE_FALLBACK_API_URL=

# ── Maintenance secrets — .env.maintenance (SEPARATE gitignored file) ────────
# One-time backfill scripts and server-side tooling read these via
# scripts/load-maintenance-env.ts. Create .env.maintenance locally with:
#   SUPABASE_URL=
#   SUPABASE_SERVICE_ROLE_KEY=
#   EXCHANGE_RATE_API_KEY=
#   EXCHANGE_RATE_HOST_ACCESS_KEY=
#   # Canonical record of the custom-SMTP credentials configured in the
#   # Supabase Dashboard (no script reads these — see docs/custom-smtp-email.md):
#   EMAIL_SERVER_HOST=smtp.gmail.com
#   EMAIL_SERVER_PORT=587
#   EMAIL_SERVER_USER=
#   EMAIL_SERVER_PASSWORD=        # Gmail: 16-char App Password, NOT the account password
#   EMAIL_FROM=SpendFlow <you@example.com>
# Rotate the service-role key if it was ever present in an old .env copy
# (Dashboard → Settings → API → service_role → Rotate).
