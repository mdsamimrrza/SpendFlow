  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "verify:fx": "tsx scripts/verify-exchange-rate-context.ts",
    "verify:format": "tsx scripts/verify-formatting.ts",
    "verify:ocr": "node scripts/test-receipt-ocr.cjs",
    "verify:export": "node scripts/test-export-base64.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx eas build -p android --profile preview",
    "build:production": "npx eas build -p android --profile production"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "0.5.1",
    "node-forge": "1.4.2",
    "shell-quote": "1.12.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition"
        ],
        "listUnknownPackages": false
      }
    }
  }
